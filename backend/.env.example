# Runtime (set NODE_ENV=production on Render; Render injects PORT automatically)
PORT=5000
NODE_ENV=development

# Comma-separated frontend origins (production requires explicit https:// origins, no *)
# Example production value: https://eth-wallet-dapp.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Sign-In with Ethereum (EIP-4361; production requires matching https:// SIWE_URI and host)
# Example production values: SIWE_DOMAIN=eth-wallet-dapp.vercel.app, SIWE_URI=https://eth-wallet-dapp.vercel.app
SIWE_DOMAIN=localhost:5173
SIWE_URI=http://localhost:5173
SIWE_CHAIN_ID=11155111
NONCE_TTL_SECONDS=300

# Supabase (use Secret / service_role key only — never publishable/anon key)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=

# Ethereum Sepolia RPC & Deployed Contract
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
CONTRACT_ADDRESS=0xD3F26853AF8cC8f3e41a50305692b754a3dd3d67

# JWT Signing (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Incremental Blockchain Synchronization
CONTRACT_DEPLOYMENT_BLOCK=12203912
SYNC_BLOCK_RANGE=10
SYNC_MAX_BLOCKS=200
SYNC_CONFIRMATIONS=12
